<?xml version="1.0" encoding="UTF-8"?>
<!--
  微信支付旧版（V2）错误信封。V3 官方只回 JSON，但院方网关代理、老接入
  兼容层偶尔会吐回这种 XML。本产品走 V3 协议，遇到非 JSON 必须**显式归一为
  CHANNEL_REQUEST_FAILED**（而不是解析失败后当成空账单当作成功）。
  回放样例，字段按 V2 官方规范，非任何真实商户数据。
-->
<xml>
    <return_code>FAIL</return_code>
    <ret_msg>签名错误</ret_msg>
    <err_code>NO_AUTH</err_code>
    <err_code_des>商户号与API密钥不匹配</err_code_des>
</xml>
