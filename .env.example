# 凭据位示例：全部从环境变量读取，无硬编码。
# 复制为 .env 后按院内实际填写；.env 已被 .gitignore 排除。

# ---- 微信支付商户平台（GET /v3/bill/tradebill，下载链接 5 分钟有效）----
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_API_V3_KEY=
# 平台证书（BEGIN CERTIFICATE）路径：用于**验签取件响应**，缺它时拒绝调用该渠道
WECHAT_PLATFORM_CERT_PATH=
# 平台证书序列号：与响应头 Wechatpay-Serial 比对，不一致即拒绝验签
WECHAT_PLATFORM_CERT_SERIAL_NO=

# ---- 支付宝开放平台（POST gateway.do，RSA2，下载链接 30 秒有效）----
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
# 支付宝公钥（BEGIN PUBLIC KEY）路径：用于**验签 gateway 响应**
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# RSA2 摘要算法：MD5（院内老接入默认）或 SHA1（官方 SDK 口径）
ALIPAY_SIGN_DIGEST=MD5

# ---- HIS 收费流水只读库（SQLAlchemy，必须为只读账号）----
HIS_DB_DSN=
HIS_DB_POOL_SIZE=5
HIS_DB_POOL_TIMEOUT=10
HIS_DB_QUERY_TIMEOUT_SECONDS=30
# 池满后的额外连接数：默认 0 = 绝不因为对账把院内 HIS 的 max_connections 顶穿
HIS_DB_POOL_MAX_OVERFLOW=0
# 连接回收秒数：默认 0 = 不主动回收
HIS_DB_POOL_RECYCLE=0
# 服务端语句超时（毫秒，留空 = 不设）。PostgreSQL 映射 statement_timeout、
# MySQL 映射 max_execution_time：让慢查询在**数据库那边**就收手，而不是
# 客户端干等到 deadline。SQLite 无对应设置，此时只靠 HIS_DB_QUERY_TIMEOUT_SECONDS
HIS_DB_STATEMENT_TIMEOUT_MS=

# ---- 企业微信机器人（仅超阈值摘要与深链，不发金额明细）----
# key = 群机器人地址末尾那段 uuid；机器人被移出群后 key 立即失效
# （errcode 93000，本产品判为不可重试，面板显示「推送失败」而非反复退避）
WECOM_WEBHOOK_KEY=
# 两条阈值线**独立判定**：条数超了即便金额没超也要推（38 条挂着的单子
# 正是最该叫醒人的）。任一条留空 = 该线不参与判定；两条都留空 = 永不推送。
# 写错（如「20 条」「abc」、负数）在**装配时**即报 WECOM_THRESHOLD_INVALID，
# 不静默忽略 —— 静默忽略会变成「每期都推」。
RECONQ_WECOM_UNBALANCED_COUNT_THRESHOLD=30
# 定点数，不带货币符号与千分位。写「5000」等价于「5000.00」
RECONQ_WECOM_UNBALANCED_AMOUNT_THRESHOLD=5000.00
# 面板基址（深链 reconq:// 与正文里的面板地址都用它），留空取默认
RECONQ_PANEL_BASE=http://127.0.0.1:8788

# ---- 模型服务（OpenAI-compatible，仅用于单边账成因草稿）----
# 只出「草稿」：{cause, confidence, evidence_refs[], explanation_zh}。
# 四个位任一缺位，网关在**发请求前**即拒（MODEL_CONFIG_INVALID 并点名变量），
# 不提供「缺 base_url 就走默认端点」的兜底 —— 那等于把含金额与订单号的
# 证据包发给一个不知道是哪个服务的模型。本地模型、院内自建端点、云服务
# 共用这四个位，换厂商改的是这里，不是代码。
RECONQ_MODEL_BASE_URL=http://127.0.0.1:8000/v1
RECONQ_MODEL_API_KEY=
RECONQ_MODEL_NAME=
# 超时**分两层**，排查方向不同，合成一个数时两种问题都指向同一句话：
#   RECONQ_MODEL_TIMEOUT          读超时（连上了但不回话）→ 先查 GPU 队列与模型是否加载完
#   RECONQ_MODEL_CONNECT_TIMEOUT  连接超时（连都没连上）  → 先查院内网络与推理服务进程是否在监听
# 都留空有默认值（30 / 5），配了必须是正数（0 或负数会让每次调用立刻
# 「超时」，看起来像服务挂了）。连接超时须**短于**读超时，配反了会在发请求前
# 被拒并点名这两个变量 —— 不静默收紧，那会让人以为「已经调过连接超时了」。
#
# 超时走降级路径：只报确定性口径结论 + 全部差异标待人工判定，**不阻塞扫描**、
# 不推进任何台账状态。重试与熔断参数在 degradation.py 的 RETRY_MATRIX /
# DEFAULT_BREAKER_* 里（改数字前先读那一行的 rationale —— 四类失败各有各的
# 节奏，统一成一个数等于没分类）。熔断开启期间**一个请求都不发**：院内推理服务
# 挂起来往往不是拒绝而是不回应，每条差异都等满超时会把这期扫描从 40 秒拖成
# 40 分钟。闸开着期间面板显示「本期 N 条降级、熔断 HH:MM 开 / HH:MM 恢复」。
RECONQ_MODEL_TIMEOUT=20
RECONQ_MODEL_CONNECT_TIMEOUT=5

# ---- 模型成本计量（reconq model-usage）----
# 单价单位是**元 / 千 token**。两个位都留空 = 不做成本估算，面板与终端
# 显示「未配置单价」而**不是「0.00 元」** —— 显示 0 元会被读成「这一期真
# 的一次钱没花」，而真相是「不知道」。院内自建端点通常没有公开单价，
# 本产品也**不内置任何厂商价格**：内置价在换模型时会静默算错，而算错的
# 钱数没人会去核。只配一个也不行：归因任务的生成 token 往往不比提示词少，
# 半截计价会给出一个看起来完整的数字。
# 非法值（非数字 / 负数）报 MODEL_PRICE_INVALID 点名变量，不静默回落 0。
RECONQ_MODEL_PRICE_PROMPT_PER_1K=
RECONQ_MODEL_PRICE_COMPLETION_PER_1K=
#
# 成本表（reconq model-usage --period 2026-W36）回答的三个问题：
#   「这一期调了几次」有两个答案 —— 总次数含缓存命中，真正打到端点上的是
#   「真正发出 N 次」，差着好几倍，财务科问「花了多少钱」指的是后者。
#   「同一份证据、同一版提示词问过两次」不再问第二次：缓存键 =
#   证据包字节 sha256 + 提示词版本 + 模型名，三者缺一就是**静默的错误**
#   （不报错、不降级，只是答案悄悄变了）。
#   审计表**只存指纹与体量，不存证据正文**。要复现某次调用，凭指纹去
#   证据快照（align/snapshot.py）取 —— 那是唯一带源文件行号可回查的地方。
#   审计表 append-only：触发器挡住 UPDATE/DELETE，指纹链检出绕过触发器的
#   改动并指出第几条（reconq model-usage 校验不过时退出码为 1）。

# ---- 服务与运行参数 ----
RECONQ_HOST=127.0.0.1
RECONQ_PORT=8788
RECONQ_TZ=Asia/Shanghai

# ---- 对齐倒排索引的内存预算（Task 22）----
# 常驻倒排表的内存上限，单位 MB，**只填数字**。留空 = 64MB。
# 非法值（0 / 负数 / 带单位 / 非数字）会显式报 INDEX_BUDGET_INVALID 而不
# 静默回落默认 —— 填 0 等于没有上限，正是这个预算要防的情况。
# 它约束的是**倒排映射**（单号 → 候选引用），不含记录载荷；载荷的内存由
# 取数侧的分批预算（8MB/批，Task 6）管。spill 只腾倒排表，弱匹配遍历的
# 记录全集永不驱逐 —— 否则「找不到候选」会静默变成单边账。
RECONQ_INDEX_BUDGET_MB=64
# 常驻条目数硬阈值（键数）。与上面的字节预算**双阈值**、先到先触发：
# 单号特别长时（院内有些系统用 32 位流水号 + 前缀），光键就能吃光字节预算。
RECONQ_INDEX_SPILL_ENTRIES=200000
# LRU 缓存条目数。spill 之后按 offset 回查的结果也进这个缓存；
# 缓存里的键算「热」，不会被当成冷块再次落盘。
RECONQ_INDEX_CACHE_SIZE=4096

# ---- 结构化 JSON 日志 ----
# 每次运行落一份 logs/reconq-<日期>.jsonl，每行含 ts/level/event/channel/period/
# code/duration_ms 七个固定字段。日志里的患者标识在写盘前自动脱敏。
# 留空 = 自动判定（round 根的 logs/，不写项目子目录）。
# 也可用命令行 --log-dir 覆盖，或用 --no-log 本次不落盘。
RECONQ_LOG_DIR=
